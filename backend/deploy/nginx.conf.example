# http context. Replace domain/certificates and validate with nginx -t.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name api.campus.example.com;
    ssl_certificate /etc/letsencrypt/live/api.campus.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.campus.example.com/privkey.pem;
    client_max_body_size 6m;
    location / {
        proxy_pass http://127.0.0.1:5080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite client-supplied forwarding headers for this single trusted hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
