[Unit]
Description=CampusConnect API
After=network-online.target
Wants=network-online.target

[Service]
User=campusconnect
WorkingDirectory=/opt/campusconnect
EnvironmentFile=/etc/campusconnect/backend.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
ExecStart=/usr/bin/dotnet /opt/campusconnect/CampusConnect.Api.dll
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
