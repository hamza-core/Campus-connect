ASPNETCORE_URLS=http://127.0.0.1:5080
# Required SQL authentication for EC2/RDS. Use a trusted SQL Server certificate.
ConnectionStrings__DefaultConnection=Server=your-rds-endpoint,1433;Database=CampusConnect;User Id=campusconnect;Password=replace-with-private-password;Encrypt=true;TrustServerCertificate=false
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=https://your-frontend.example.com
TRUSTED_PROXIES=127.0.0.1,::1
# Required only for explicit --seed; never commit a shared password.
SEED_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
